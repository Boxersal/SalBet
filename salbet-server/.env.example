# Copy this file to .env and fill in real values before running.
# Never commit your real .env file.

# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Port the server listens on (Render sets this automatically in production)
PORT=3000

# Where the SQLite database file lives. On Render, set this to a path on your
# mounted persistent disk, e.g. /data/salbet.db, so data survives restarts/redeploys.
DB_PATH=./salbet.db
